

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>sinatra</title>
<link rel="stylesheet" href="<%= url("/style.css") %>">
</head>
<body>
  <a href="/memos">← メモ一覧に戻る</a>
  <h2><%= h(@memo[:title]) %></h2>
  <h4><%= h(@memo[:content]) %></h4>

<div class="update-buttons">
  <form action="/memos/<%= @memo[:id] %>" method="post" class="app-button">
     <input type="hidden" name="_method" value="delete">
    <input type="submit" value="削除する">
  </form>

  <div class="app-button">
    <a href="/memos/<%= @memo[:id] %>/edit">編集する</a>
  </div>
</div>

</body>
</html>
