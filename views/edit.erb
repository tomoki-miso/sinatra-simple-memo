<a href="/memos">← メモ一覧に戻る</a>
<h2>メモの編集</h2>
<form action="/memos/<%= @memo.id %>" method="post" class="memo-forms">
  <input type="hidden" name="_method" value="patch">
  <div class="memo-form">
    <label for="title">タイトル</label>
    <input type="text" name="title" id="title" value="<%= h(@memo.title) %>" required>
  </div>

  <div class="memo-form">
    <label for="content">内容</label>
    <textarea name="content" id="content" rows="8" cols="40" required><%= h(@memo.content) %></textarea>
  </div>

  <div class="app-button">
    <input type="submit" value="編集完了">
  </div>
</form>
